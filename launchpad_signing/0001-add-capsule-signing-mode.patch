+    def generateCapsuleKeys(self):
+        """Refuse to generate capsule keys for this archive.
+
+        Every other key type here is safe to autogenerate: a fresh
+        self-signed key produces a signature that whoever consumes it was
+        always going to have to be told about.  A capsule is different.  It
+        is verified before the OS starts, against a single root certificate
+        fused into the device, and there is no way to add to that store from
+        the archive side.  Autogenerating a key would therefore produce
+        capsules that build, publish and install perfectly and are then
+        silently rejected by every device that receives them.
+
+        Capsule keys must be provisioned deliberately, with a chain that
+        terminates at a root the target firmware already trusts.
+        """
+        raise CannotAutogenerateKeyError(
+            "Capsule signing keys cannot be autogenerated: a capsule must "
+            "chain to a root certificate provisioned in the device "
+            "firmware. Install capsule.key, capsule.crt and optionally "
+            "capsule-chain.pem under the archive signing root."
+        )
+
+    def signCapsule(self, image):
+        """Attempt to sign a UEFI firmware management capsule payload.
+
+        The image here is not a capsule; it is the blob the capsule's
+        authentication header covers, which the uploader extracted precisely
+        so that this step would not need to know anything about capsule
+        layout.  What comes back is a detached PKCS#7 SignedData.
+
+        Two properties distinguish this from the kmod-style signatures above,
+        and both are required by the EDK2 verifier:
+
+        * the certificate chain is embedded in the signature, because the
+          firmware has no certificate store to look a signer up in; and
+        * the signed attributes are present, because the verifier expects
+          a CMS structure rather than a bare signature.
+
+        That is why this cannot reuse ``kmodsign -D``, which omits both.
+        """
+        image_sig = "%s.sig" % image
+        remove_if_exists(image_sig)
+        (key, cert) = self.getKeys(
+            "Capsule",
+            self.generateCapsuleKeys,
+            self.capsule_key,
+            self.capsule_cert,
+        )
+        if not key or not cert:
+            return
+        self.publishPublicKey(cert)
+        cmdl = [
+            "openssl",
+            "smime",
+            "-sign",
+            "-binary",
+            "-outform",
+            "DER",
+            "-md",
+            "sha256",
+            "-signer",
+            cert,
+            "-inkey",
+            key,
+            "-in",
+            image,
+            "-out",
+            image_sig,
+        ]
+        if self.capsule_chain and os.path.exists(self.capsule_chain):
+            cmdl[-4:-4] = ["-certfile", self.capsule_chain]
+        return self.callLog("Capsule signing", cmdl) == 0
+
     def convertToTarball(self):
